# Port the booking API listens on
PORT=5000
# MongoDB connection string (a separate database from the planner's)
MONGO_URI=mongodb://localhost:27017/eco_bookings
# Must be identical to the planner server's JWT_SECRET so planner tokens are accepted
JWT_SECRET=change_me
# "mongo" for persistence, "memory" for an ephemeral in-process store (useful for demos and tests)
DATA_DRIVER=mongo
# Load the sample catalogue of eco stays and restaurants when the catalogue is empty
SEED_ON_START=true
# Allowed browser origin(s), comma separated, or * for any
CORS_ORIGIN=*
